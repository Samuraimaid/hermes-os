# Hermes OS — copy to .env and adjust per local
APP_NAME=Hermes OS
APP_ENV=development

# Which venue profile to load (restaurant | bar | buffet | qsr | convenience)
HERMES_PROFILE=restaurant

# Modules: comma-separated. Empty = use profile defaults.
# sala,barra,cocina,mostrador,pantallas,caja
HERMES_MODULES=

# local | cloud | hybrid
HERMES_DEPLOYMENT=local

POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*

VENUE_NAME=Local demo
VENUE_SLUG=demo
DATABASE_URL=

# Optional store tax. Off by default. bps: 1500 = 15%. Not a fiscal invoice.
HERMES_TAX_ENABLED=false
HERMES_TAX_BPS=1500
