# Hermes OS — copy to .env and adjust per local
APP_NAME=Hermes OS
APP_ENV=development

# Which venue profile to load (restaurant | bar | buffet | qsr | convenience)
HERMES_PROFILE=restaurant

# Modules: comma-separated. Empty = use profile defaults.
# sala,barra,cocina,mostrador,pantallas,caja
HERMES_MODULES=

POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
